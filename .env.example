# Used by docker-compose.yml for the Go backend
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional (only needed when running `go run .` locally without Docker)
# PORT=8080
# DB_PATH=./data/piraya.db

# Optional: Only if you still use Firestore in frontend/src/components/EventsSection.vue
# (Vue CLI reads these from frontend/.env at build time)
# VUE_APP_FIREBASE_API_KEY=
# VUE_APP_FIREBASE_AUTH_DOMAIN=
# VUE_APP_FIREBASE_PROJECT_ID=
# VUE_APP_FIREBASE_STORAGE_BUCKET=
# VUE_APP_FIREBASE_MESSAGING_SENDER_ID=
# VUE_APP_FIREBASE_APP_ID=
